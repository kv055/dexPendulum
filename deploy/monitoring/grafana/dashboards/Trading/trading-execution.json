  {
   "id": 6,
   "type": "stat",
   "title": "LND channels (active)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 20,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     },
     "decimals": 0
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(dex_lnd_channels{active=\"true\"}) or (dex_lnd_wallet_up == 0) * 0",
     "refId": "A"
    }
   ],
   "description": "Active channels. Channel/balance series are only exported while the wallet is up; reads 0 when the wallet is down."
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Order submissions (per interval)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 8,
      "spanNulls": true
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (venue, kind, result) (increase(dex_orders_placed_total[$__rate_interval]))",
     "legendFormat": "{{venue}} {{kind}} {{result}}"
    }
   ],
   "description": "Counters appear after their first event — an empty panel here means no trade activity yet, not a broken query."
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Order placement p95 latency",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 8,
      "spanNulls": true
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, venue, kind) (rate(dex_order_placement_duration_seconds_bucket[5m])))",
     "legendFormat": "{{venue}} {{kind}} p95"
    }
   ]
  },
