    }
   ]
  },
  {
   "id": 5,
   "type": "state-timeline",
   "title": "Exchange up/down",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "min": 0,
     "max": 1,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "mergeValues": true,
    "showValue": "never"
   },
   "targets": [
    {
     "expr": "dex_exchange_up",
     "legendFormat": "{{exchange}}",
     "refId": "A"
    }
   ]
  },
  {
