  {
   "type": "table",
   "title": "Recent snapshot runs (Postgres)",
   "description": "The snapshot_log table: one row per run with total offers and per-venue offer counts. 'problems' lists venues whose fetch was not complete (incomplete/failed/offline). Replaces the Snapshot Log panel that used to live in the monitor UI's Taker Controller tab.",
   "datasource": {
    "type": "postgres",
    "uid": "postgres-dexarb"
   },
   "targets": [
    {
     "datasource": {
      "type": "postgres",
      "uid": "postgres-dexarb"
     },
     "rawQuery": true,
     "editorMode": "code",
     "format": "table",
     "rawSql": "SELECT\n  timestamp AS \"time\",\n  offers_count AS \"offers\",\n  ROUND(cycle_ms / 1000.0, 1) AS \"cycle s\",\n  (exchanges->'bisq'->>'count')::int AS \"bisq\",\n  (exchanges->'bisq2'->>'count')::int AS \"bisq2\",\n  (exchanges->'hodlhodl'->>'count')::int AS \"hodlhodl\",\n  (exchanges->'robosats'->>'count')::int AS \"robosats\",\n  (exchanges->'peachbitcoin'->>'count')::int AS \"peach\",\n  (exchanges->'mostro'->>'count')::int AS \"mostro\",\n  (\n    SELECT string_agg(key || ': ' || (value->>'status'), ', ')\n    FROM jsonb_each(exchanges)\n    WHERE key IN ('bisq', 'bisq2', 'hodlhodl', 'robosats', 'peachbitcoin', 'mostro')\n      AND COALESCE(value->>'status', '') <> 'complete'\n  ) AS \"problems\"\nFROM snapshot_log\nWHERE $__timeFilter(timestamp)\nORDER BY timestamp DESC\nLIMIT 30",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto",
      "cellOptions": {
       "type": "auto"
      }
     },
     "noValue": "–"
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "problems"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 220
       },
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "red"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "footer": {
     "show": false,
     "reducer": [
      "sum"
     ],
     "fields": ""
    }
   },
   "transformations": [],
   "id": 30,
   "gridPos": {
    "h": 10,
    "w": 24,
    "x": 0,
    "y": 14
   }
