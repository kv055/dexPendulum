   "title": "Cumulative realized PnL",
   "datasource": {
    "type": "postgres",
    "uid": "postgres-dexarb"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "currencyEUR",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 8,
      "spanNulls": true
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "format": "time_series",
     "rawQuery": true,
     "rawSql": "SELECT created_at AS \"time\", SUM(total_transaction_pnl) OVER (ORDER BY created_at) AS \"cumulative PnL\" FROM transactions WHERE total_transaction_pnl IS NOT NULL AND deleted_at IS NULL ORDER BY 1"
    }
   ]
  },
