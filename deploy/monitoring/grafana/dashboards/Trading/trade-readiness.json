  {
   "type": "table",
   "title": "Unhealthy accounts",
   "description": "Accounts whose last health check failed, with time since that check ('never' = no check recorded yet). 'unknown' category = LND wallet pseudo-account.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "(dex_account_health_age_seconds + on (provider) group_left (category) (dex_account_healthy == 0)) or ((dex_account_healthy == 0) - 1)",
     "refId": "A",
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto",
      "cellOptions": {
       "type": "auto"
      }
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "since last check"
      },
      "properties": [
       {
        "id": "unit",
        "value": "s"
       },
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "-1": {
            "text": "never",
            "color": "red",
            "index": 0
           }
          }
         }
        ]
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "footer": {
     "show": false,
     "reducer": [
      "sum"
     ],
     "fields": ""
    },
    "sortBy": [
     {
      "displayName": "since last check",
      "desc": true
     }
    ]
   },
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "__name__": true,
       "instance": true,
       "job": true
      },
      "renameByName": {
       "Value": "since last check"
      },
      "indexByName": {
       "provider": 0,
       "category": 1,
       "since last check": 2
      }
     }
    }
   ],
   "id": 11,
