   "type": "stat",
   "title": "Best net premium — ask (%)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 0,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "decimals": 2,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "yellow",
        "value": 0
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "dex_best_net_premium_pct{direction=\"ask\"}",
     "refId": "A"
    }
   ],
   "description": "Best live net premium on ask offers (makers selling BTC; we buy on the DEX). Was direction=\"sell\" before the bid/ask enum rename, which left this tile empty."
