{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "uid": "dexarb-logs",
  "title": "Logs & errors",
  "tags": ["dexarbtrading", "logs"],
  "timezone": "",
  "time": {"from": "now-3h", "to": "now"},
  "refresh": "30s",
  "links": [{"title": "Dashboards", "type": "dashboards", "tags": ["dexarbtrading"], "asDropdown": true, "includeVars": false, "keepTime": true, "icon": "external link", "targetBlank": false}],
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "datasource": {"type": "loki", "uid": "loki"},
        "query": "label_values(service)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {"selected": true, "text": "All", "value": "$__all"}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Errors (range)",
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []},
      "targets": [{"datasource": {"type": "loki", "uid": "loki"}, "expr": "sum(count_over_time({service=~\"$service\", level=\"ERROR\"} [$__range]))", "queryType": "instant", "refId": "A"}]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Warnings (range)",
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}]}}, "overrides": []},
      "targets": [{"datasource": {"type": "loki", "uid": "loki"}, "expr": "sum(count_over_time({service=~\"$service\", level=\"WARN\"} [$__range]))", "queryType": "instant", "refId": "A"}]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Error rate (per min, 5m)",
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 2, "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 10}]}}, "overrides": []},
      "targets": [{"datasource": {"type": "loki", "uid": "loki"}, "expr": "sum(rate({service=~\"$service\", level=\"ERROR\"} [5m])) * 60", "queryType": "instant", "refId": "A"}]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Total log lines (range)",
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "fixed", "fixedColor": "text"}}, "overrides": []},
      "targets": [{"datasource": {"type": "loki", "uid": "loki"}, "expr": "sum(count_over_time({service=~\"$service\"} [$__range]))", "queryType": "instant", "refId": "A"}]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Log volume by level",
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "bars", "fillOpacity": 60, "stacking": {"mode": "normal"}}}, "overrides": [
        {"matcher": {"id": "byName", "options": "ERROR"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]},
        {"matcher": {"id": "byName", "options": "WARN"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "yellow"}}]},
        {"matcher": {"id": "byName", "options": "INFO"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "green"}}]},
        {"matcher": {"id": "byName", "options": "DEBUG"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "blue"}}]}
      ]},
      "targets": [{"datasource": {"type": "loki", "uid": "loki"}, "expr": "sum by (level) (count_over_time({service=~\"$service\"} [$__interval]))", "queryType": "range", "legendFormat": "{{level}}", "refId": "A"}]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Error + warn rate by service (per min)",
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "line", "fillOpacity": 10}}, "overrides": []},
      "targets": [{"datasource": {"type": "loki", "uid": "loki"}, "expr": "sum by (service) (rate({service=~\"$service\", level=~\"ERROR|WARN\"} [$__interval])) * 60", "queryType": "range", "legendFormat": "{{service}}", "refId": "A"}]
    },
    {
      "id": 7,
      "type": "logs",
      "title": "Errors & warnings",
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"h": 11, "w": 24, "x": 0, "y": 12},
      "options": {"showTime": true, "wrapLogMessage": true, "prettifyLogMessage": false, "enableLogDetails": true, "dedupStrategy": "none", "sortOrder": "Descending"},
      "targets": [{"datasource": {"type": "loki", "uid": "loki"}, "expr": "{service=~\"$service\", level=~\"ERROR|WARN\"} | json", "queryType": "range", "refId": "A"}]
    },
    {
      "id": 8,
      "type": "logs",
      "title": "All logs (filtered by $service)",
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"h": 11, "w": 24, "x": 0, "y": 23},
      "options": {"showTime": true, "wrapLogMessage": true, "prettifyLogMessage": false, "enableLogDetails": true, "dedupStrategy": "none", "sortOrder": "Descending"},
      "targets": [{"datasource": {"type": "loki", "uid": "loki"}, "expr": "{service=~\"$service\"} | json", "queryType": "range", "refId": "A"}]
    }
  ]
}
