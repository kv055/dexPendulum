    }
   },
   "targets": [
    {
     "refId": "A",
     "format": "time_series",
     "rawQuery": true,
     "rawSql": "SELECT $__timeGroup(first_seen, '1h') AS \"time\", exchange AS metric, COUNT(*) AS value FROM offers WHERE $__timeFilter(first_seen) GROUP BY 1, 2 ORDER BY 1"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Closed-offer lifetime (avg hours, by exchange)",
   "datasource": {
    "type": "postgres",
    "uid": "postgres-dexarb"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "h",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 8,
      "spanNulls": true
     }
    },
    "overrides": []
