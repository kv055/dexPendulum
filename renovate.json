{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "baseBranchPatterns": [
    "develop"
  ],
  "ignorePaths": [
    "**/node_modules/**"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Self-hosted Renovate image pinned in the GitHub and Gitea pipelines.",
      "managerFilePatterns": [
        "/^\\.github/workflows/ci-cd\\.yml$/",
        "/^\\.gitea/workflows/ci\\.yml$/"
      ],
      "matchStrings": [
        "RENOVATE_IMAGE: ghcr\\.io/renovatebot/renovate:(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "ghcr.io/renovatebot/renovate",
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Gitea's act_runner speaks the v3 artifact protocol and the cache API used by @actions/cache 4.x; never move these past their current majors in .gitea/.",
      "matchFileNames": [
        ".gitea/workflows/**"
      ],
      "matchPackageNames": [
        "actions/upload-artifact",
        "actions/download-artifact",
        "actions/cache"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "The frontend e2e job pins ubuntu-24.04 because Playwright 1.59 cannot install Chromium on 26.04; lift this rule together with that pin.",
      "matchFileNames": [
        ".github/workflows/ci-cd.yml"
      ],
      "matchDatasources": [
        "github-runners"
      ],
      "matchPackageNames": [
        "ubuntu"
      ],
      "enabled": false
    },
    {
      "description": "Tempo 3 removes the ingester/compactor config blocks deploy/monitoring/tempo/tempo.yml relies on and will not start with it; stay on 2.x until that config is migrated.",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "grafana/tempo"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    }
  ]
}
