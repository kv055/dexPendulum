  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "New offers per hour by exchange",
   "datasource": {
    "type": "postgres",
    "uid": "postgres-dexarb"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
