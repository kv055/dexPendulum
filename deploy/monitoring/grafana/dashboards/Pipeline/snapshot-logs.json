  {
   "type": "timeseries",
   "title": "RoboSats coordinator responses",
   "description": "Each coordinator book (currency x side) is polled over Tor. 404 = empty book. Books that answered not_found twice in a row are skipped with a growing back-off (ROBOSATS_EMPTY_BOOK_MAX_SKIP, default 30m), so most empty-book round-trips turn into 'skipped'.",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
