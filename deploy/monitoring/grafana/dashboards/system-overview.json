{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "uid": "dexarb-overview",
  "title": "System overview (golden signals)",
  "tags": ["dexarbtrading", "overview"],
  "timezone": "",
  "time": {"from": "now-6h", "to": "now"},
  "refresh": "30s",
  "links": [{"title": "Trade readiness", "type": "link", "url": "/grafana/d/dexarb-trade-readiness", "icon": "dashboard", "keepTime": true, "targetBlank": false, "tooltip": "Can the bot trade right now?"}, {"title": "Dashboards", "type": "dashboards", "tags": ["dexarbtrading"], "asDropdown": true, "includeVars": false, "keepTime": true, "icon": "external link", "targetBlank": false}],
  "templating": {"list": []},
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Exchanges up",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(dex_exchange_up)", "refId": "A"}]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Snapshot age (s)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 0},
      "fieldConfig": {"defaults": {"unit": "s", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 120}, {"color": "red", "value": 180}]}}, "overrides": []},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "dex_snapshot_age_seconds", "refId": "A"}]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Errors (last 5m)",
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 0},
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 25}]}}, "overrides": []},
      "targets": [{"datasource": {"type": "loki", "uid": "loki"}, "expr": "sum(count_over_time({level=\"ERROR\"} [5m]))", "queryType": "instant", "refId": "A"}]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Healthy accounts",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 0},
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(dex_account_healthy)", "refId": "A"}]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Net-profitable offers",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 4, "w": 4, "x": 16, "y": 0},
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(dex_net_profitable_offers)", "refId": "A"}]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Active WS clients",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 4, "w": 4, "x": 20, "y": 0},
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "fixed", "fixedColor": "text"}}, "overrides": []},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(dex_ws_clients)", "refId": "A"}]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "HTTP error rate (5xx) by service",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"drawStyle": "line", "fillOpacity": 20}}, "overrides": []},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (service) (rate(http_requests_total{status=~\"5..\"}[5m]))", "legendFormat": "{{service}}", "refId": "A"}]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Error log rate by service (per min)",
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "line", "fillOpacity": 20}}, "overrides": []},
      "targets": [{"datasource": {"type": "loki", "uid": "loki"}, "expr": "sum by (service) (rate({level=\"ERROR\"} [$__interval])) * 60", "queryType": "range", "legendFormat": "{{service}}", "refId": "A"}]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "HTTP p95 latency by service (s)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "fieldConfig": {"defaults": {"unit": "s", "custom": {"drawStyle": "line", "fillOpacity": 0}}, "overrides": []},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.95, sum by (service, le) (rate(http_request_duration_seconds_bucket[5m])))", "legendFormat": "{{service}}", "refId": "A"}]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Data freshness — snapshot age & ingest rate",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "line", "fillOpacity": 10}}, "overrides": [
        {"matcher": {"id": "byName", "options": "snapshot age (s)"}, "properties": [{"id": "unit", "value": "s"}, {"id": "custom.axisPlacement", "value": "right"}]}
      ]},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "rate(dex_live_offers_pushed_total[5m]) * 60", "legendFormat": "ingest (pushes/min)", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "dex_snapshot_age_seconds", "legendFormat": "snapshot age (s)", "refId": "B"}
      ]
    },
    {
      "id": 11,
      "type": "logs",
      "title": "Recent errors (all services)",
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 20},
      "options": {"showTime": true, "wrapLogMessage": true, "prettifyLogMessage": false, "enableLogDetails": true, "dedupStrategy": "none", "sortOrder": "Descending"},
      "targets": [{"datasource": {"type": "loki", "uid": "loki"}, "expr": "{level=\"ERROR\"} | json", "queryType": "range", "refId": "A"}]
    }
  ]
}
