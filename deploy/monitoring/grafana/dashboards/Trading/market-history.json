     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "format": "time_series",
     "rawQuery": true,
     "rawSql": "SELECT $__timeGroup(last_seen, '1h') AS \"time\", exchange AS metric, AVG(duration) / 3600.0 AS value FROM offers WHERE $__timeFilter(last_seen) AND duration IS NOT NULL GROUP BY 1, 2 ORDER BY 1"
    }
   ]
  },
