  "list": []
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Realized PnL — total",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 0,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "currencyEUR",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "yellow",
        "value": 0
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     },
     "decimals": 2
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "dex_trade_pnl_eur{stat=\"total\"}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 2,
   "type": "stat",
