 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Net premium over time (avg by direction)",
   "datasource": {
    "type": "postgres",
    "uid": "postgres-dexarb"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 8,
      "spanNulls": true
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "format": "time_series",
     "rawQuery": true,
     "rawSql": "SELECT $__timeGroup(ol.snapshot_time, $__interval) AS \"time\", o.direction AS metric, AVG(ol.net_premium_pct) AS value FROM order_lifecycle ol JOIN offers o ON o.id = ol.offer_db_id WHERE $__timeFilter(ol.snapshot_time) GROUP BY 1, 2 ORDER BY 1"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Best net premium over time (max by direction)",
   "datasource": {
    "type": "postgres",
