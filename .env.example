# Container registry (GHCR) coordinates used by docker-compose.yml.
# IMAGE_OWNER must be the lowercase GitHub owner that hosts the packages.
# IMAGE_TAG is the local/default fallback. Transactional deployments override it
# with the per-service tags below and persist those values with each release, so
# an unchanged service keeps its existing image (and container) across deploys.
# IMAGE_REGISTRY overrides ghcr.io (e.g. a Gitea mirror); leave empty for default.
IMAGE_OWNER=kv055
IMAGE_TAG=latest
IMAGE_REGISTRY=
TOR_IMAGE_TAG=
BISQ_IMAGE_TAG=
BISQ2_IMAGE_TAG=
BITCOIND_RPC_PROXY_IMAGE_TAG=
UNIFIED_API_IMAGE_TAG=
UNIFIED_SNAPSHOT_IMAGE_TAG=
POSTGRES_BACKUP_IMAGE_TAG=
DEXMONITOR_IMAGE_TAG=
MM_CONTROLLER_IMAGE_TAG=
TOTP_API_IMAGE_TAG=
FIAT_CONTROLLER_IMAGE_TAG=

# GoDaddy Personal Access Token for Terraform-managed DNS. Grant only
# domains.domain:read and domains.dns:update; never commit the real token.
GODADDY_PAT=

# Public HTTPS edge. Let’s Encrypt uses this contact address for expiry and
# security notices; it does not need to be a mailbox on this domain.
PUBLIC_HOSTNAME=dex.example.com
LETSENCRYPT_EMAIL=your-godaddy-account-email@example.com
DEXMM_TELEGRAM_WEBHOOK_URL=https://dex.example.com/telegram-webhook
# Required for Telegram webhook delivery. Use a long random value; Telegram
# echoes it in every callback and mm-controller rejects callbacks without it.
TELEGRAM_WEBHOOK_SECRET=change_me_long_random_telegram_webhook_secret
# Required for public Android phone-payment callbacks. The dashboard reveals
# this only after login. Both notification and heartbeat callbacks use it, and
# fail closed when it is empty.
PUSHPUSH_NOTIFY_SECRET=change_me_long_random_pushpush_secret
PUSHPUSH_HEARTBEAT_MAX_AGE=15m

POSTGRES_DB=dexarb
POSTGRES_ADMIN_USER=dex_admin
POSTGRES_ADMIN_PASSWORD=change_me_admin_password
POSTGRES_UNIFIED_API_PASSWORD=change_me_unified_api_password
POSTGRES_MONITOR_PASSWORD=change_me_monitor_password
POSTGRES_MM_CONTROLLER_PASSWORD=change_me_mm_controller_password
POSTGRES_FIAT_CONTROLLER_PASSWORD=change_me_fiat_controller_password
# Read-only Postgres role for Grafana's postgres-dexarb datasource login
# (dex_grafana_ro). Must equal dexUnifiedApi's POSTGRES_GRAFANA_RO_PASSWORD:
# unified-api's role bootstrap ALTERs the role to its value at every start,
# and compose interpolates this one into the Grafana container.
POSTGRES_GRAFANA_RO_PASSWORD=
# Generic Postgres role consumed as POSTGRES_USER by some compose services and
# as POSTGRES_GRAFANA_RO_PASSWORD by the Grafana read-only role. Leave empty
# unless the monitoring stack requires them.
POSTGRES_USER=
POSTGRES_GRAFANA_RO_PASSWORD=

# Receive-only payment mailbox (Maddy). Point MADDY_HOSTNAME at an A/AAAA
# record and MADDY_DOMAIN's MX at that hostname. Put the matching TLS files in
# deploy/maddy/tls/{fullchain.pem,privkey.pem}.
MADDY_HOSTNAME=mx.example.com
MADDY_DOMAIN=example.com
MADDY_RECIPIENT=payments@example.com
MADDY_IMAP_PASSWORD=change_me_long_random_imap_password
MADDY_TLS_DIR=./deploy/maddy/tls
MADDY_SMTP_PORT=25

# Safe rollout starts in capture, then shadow. Active mode is rejected unless
# both UID and timestamp watermarks are set.
PAYMENT_EMAIL_MODE=capture
PAYMENT_EMAIL_POLL_INTERVAL=5m
PAYMENT_EMAIL_HEALTH_MAX_AGE=15m
PAYMENT_EMAIL_ACTIVATION_UID=0
PAYMENT_EMAIL_ACTIVATION_TIME=

# Enables mm-controller's money-moving recovery, DEX relay, and hedgeless
# execution/refill workers. Keep false until staging validation is complete.
ENABLE_AUTOMATED_TRADEFLOW_WORKERS=false
# RoboSats admission additionally requires this gate; enable only after staging.
ROBOSATS_ENABLED=false
# Optional explicit federation aliases: alias=http://coordinator.onion,...
ROBOSATS_COORDINATORS=
# Noones offer ingestion (snapshot-only, like Peach: no taker connector yet).
# Create an API key in the Noones app (P2P Market → profile → API keys), select
# the Noones API product, and copy the client id/secret here. Leave both empty
# to keep the venue absent from the snapshot instead of failing every market.
NOONES_CLIENT_ID=
NOONES_CLIENT_SECRET=
# Alert after a Bisq buyer's fiat-sent signal remains unmatched this long.
# Set to 0 to disable; this never auto-confirms fiat receipt or releases BTC.
BISQ_FIAT_ESCALATION_AFTER=2h
# Snapshot cadence in minutes for the unified-snapshot worker and dexmonitor.
SNAPSHOT_INTERVAL_MIN=1

# Grafana admin password (used to log into https://<host>:5443/grafana/ as `admin`).
GRAFANA_ADMIN_PASSWORD=change_me_grafana_admin_password

# Read-only Grafana service-account token handed to scraping agents so they can
# query the Prometheus/Loki/Tempo datasources over the TLS edge. NOT consumed by
# any compose service — kept here as the documented home (store the real value in
# .env.enc). Also read by deploy/monitoring/grafana/run-mcp.sh (Cursor MCP).
# Mint it once with deploy/monitoring/grafana/bootstrap-agent-token.sh;
# see deploy/monitoring/README.md "Agent datasource access".
GRAFANA_AGENT_TOKEN=

# ─── OpenTelemetry (logs + traces) ───────────────────────────────────────────
# All optional — docker-compose ships sensible defaults. The Go services push
# OTLP traces to Alloy, which forwards to Tempo; structured JSON logs go to
# stdout and Alloy scrapes them into Loki. View both in Grafana.
#   OTEL_EXPORTER_OTLP_ENDPOINT  collector address (default alloy:4317). Empty
#                                disables tracing entirely.
#   OTEL_TRACES_SAMPLER_ARG      head sampling ratio 0..1 (default 1.0; lower in
#                                prod if trace volume gets heavy).
#   LOG_LEVEL                    debug|info|warn|error (default info).
#   DEPLOY_ENV                   resource attribute deployment.environment.
# OTEL_EXPORTER_OTLP_ENDPOINT=alloy:4317
# OTEL_TRACES_SAMPLER_ARG=1.0
# LOG_LEVEL=info
# DEPLOY_ENV=production

# Shared secret guarding the unified-api internal ingest endpoint
# (POST /internal/live_offers). The snapshot tool sends it as the
# X-Internal-Secret header; the server rejects mismatches with 401. Leave empty
# to disable the check (dev/local). Set to a long random value in production.
INTERNAL_API_SECRET=change_me_internal_api_secret
# Intentionally run the internal endpoints open (dev only). Default empty =
# secure (fail closed). Compose: ALLOW_INSECURE_INTERNAL=${ALLOW_INSECURE_INTERNAL:-}.
ALLOW_INSECURE_INTERNAL=
# 32-byte base64 key used by commons/credentialcrypto to encrypt exchange API
# credentials stored in Postgres. Required by the env contract
# (scripts/validate-env-contract.sh) and injected into unified-api, snapshot,
# dexmonitor and mm-controller. Generate once, never rotate without migration.
APP_ENCRYPTION_KEY=change_me_32_byte_base64_app_encryption_key
# Shared secret for fiat-arrival payment notifications, validated by
# unified-api and sent by dexFiatController. Compose currently leaves it
# commented out; set a long random value when enabling the notification path.
PAYMENT_NOTIFICATIONS_SHARED_SECRET=
# Optional overrides for the notification path (compose defaults shown).
# PAYMENT_NOTIFICATIONS_API_URL=http://unified-api:5010/internal/payment_notifications
# PAYMENT_NOTIFICATIONS_DEX=
# Login session cookie Secure attribute. Default true (prod is HTTPS).
# Export false for local HTTP dev where browsers drop Secure cookies.
SESSION_COOKIE_SECURE=true
# How often CEX account health/permission snapshots refresh (default 10m).
ACCOUNT_HEALTH_INTERVAL=10m

# Official RoboSats federation registry used by the snapshot worker to discover
# current federated mainnet coordinators. Invalid/unavailable registries fall
# back to the bundled coordinator list.
ROBOSATS_FEDERATION_URL=https://raw.githubusercontent.com/RoboSats/robosats/main/frontend/static/federation.json
# Check at most this often; snapshots use the last valid /tmp cache between
# refreshes and retain it if a refresh fails.
ROBOSATS_FEDERATION_REFRESH_INTERVAL=6h

# A successful CEX permission snapshot older than this is no longer trusted for
# new optimizer routes or MM executions. Three default health cycles = 30m.
MM_CEX_CAPABILITY_MAX_AGE=30m
# Snapshot housekeeping consumed via compose (defaults shown).
# LIFECYCLE_RETENTION_DAYS: days of order_lifecycle history to keep (0 disables).
# LIVE_OFFER_STALE_GRACE: snapshot staleness grace before offers count as stale.
LIFECYCLE_RETENTION_DAYS=30
LIVE_OFFER_STALE_GRACE=5m

# Conservative bid-pricing reserve: max(floor, multiplier × express 2-in/2-out
# P2WPKH mempool fee, largest observed Coinbase send fee in the last 30 days).
COINBASE_WITHDRAW_RESERVE_FLOOR_SAT=10000
COINBASE_WITHDRAW_RESERVE_MULTIPLIER=2

# Postgres logical backups. The postgres-backup sidecar creates pg_dump -Fc
# archives and uploads them with rclone copy.
PG_BACKUP_ENABLED=true
PG_BACKUP_INTERVAL=6h
PG_BACKUP_FILE_PREFIX=dexarb
PG_BACKUP_RETENTION_DAYS=14
PG_BACKUP_UPLOAD=true
PG_BACKUP_UPLOAD_REQUIRED=true
PG_BACKUP_RCLONE_REMOTE=proton:postgres-backups/dexarb
PG_BACKUP_COMMAND_TIMEOUT=2h

# Proton Drive primary target. Rclone's Proton Drive backend is beta, so test
# unattended uploads before relying on it.
RCLONE_CONFIG_PROTON_TYPE=protondrive
RCLONE_CONFIG_PROTON_USERNAME=your@email.com
RCLONE_CONFIG_PROTON_PASSWORD=
# RCLONE_CONFIG_PROTON_2FA=

# Dropbox fallback target. Generate the token once with `rclone config` on a
# trusted machine, then paste the token JSON here.
# PG_BACKUP_RCLONE_REMOTE=dropbox:postgres-backups/dexarb
# RCLONE_CONFIG_DROPBOX_TYPE=dropbox
# RCLONE_CONFIG_DROPBOX_TOKEN=

# ─── Bisq ─────────────────────────────────────────────────────────────────────
# Bisq 1 (gRPC on port 9998)
BISQ_API_PASSWORD=
BISQ_WALLET_PASSWORD=
BISQ_ACCOUNT_FILE_PATH=

# Bisq 2 (REST API on port 8090).
BISQ2_API_PASSWORD=
BISQ2_WALLET_PASSWORD=
BISQ2_ACCOUNT_FILE_PATH=

# ─── Cross-service wiring (consumed via docker-compose.yml) ─────────────────
# Telegram operator bot shared by mm-controller and fiat-controller pushpush.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Pushpush dex-release webhook (fiat-controller -> mm-controller BTC release).
PUSHPUSH_DEX_RELEASE_URL=http://dexmmcontroller:8080/api/webhooks/dex-release
PUSHPUSH_DEX_RELEASE_TOKEN=
# Compose maps the token above to DEX_RELEASE_WEBHOOK_TOKEN on mm-controller;
# empty on either side disables the release webhook (mm-controller answers 503).
PUSHPUSH_RELEASE_TIMEOUT=10s
PUSHPUSH_TELEGRAM_WEBHOOK_URL=
# Bid-side pre-trade checks fail closed unless the fiat controller is reachable.
FIAT_CONTROLLER_URL=http://fiat-controller:8080

# ─── Fiat scraping fallback (optional, off by default) ──────────────────────
# Browser automation is the last-resort fiat-arrival path; pushpush is primary.
SCRAPING_ENABLED=false
POLL_INTERVAL=30s
OPENAI_API_KEY=
TOTP_API_KEY=
SMS_PROVIDER=
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_PHONE_NUMBER=
# EMAIL_IMAP_* below is the scraping connector's email-2FA inbox, separate from
# the Maddy receive-only payment mailbox above.
EMAIL_PROVIDER=
EMAIL_IMAP_HOST=
EMAIL_IMAP_USER=
EMAIL_IMAP_PASS=
# Compose maps the payment mailbox from MADDY_* by default; override only when
# the payment inbox lives somewhere other than the bundled Maddy server.
PAYMENT_EMAIL_IMAP_HOST=maddy
PAYMENT_EMAIL_TLS_CA_FILE=/maddy-tls/fullchain.pem

# LND image pin consumed by the lnd service (default 0.18.4-beta).
LND_VERSION=0.18.4-beta

# ─── dexMonitor Settings page ───────────────────────────────────────────────
# Point at a writable mount of THIS file to let the authenticated Settings page
# (PUT /api/app-settings) persist the user-facing variables above. The
# dexmonitor compose service does not mount it by default; enable with:
#   volumes: ["./.env:/settings/root.env:rw"]  (dexmonitor service)
#   environment: ["SETTINGS_ENV_FILE=/settings/root.env"]  (dexmonitor service)
# Note: setting SETTINGS_ENV_FILE in this file alone is NOT enough — compose
# uses this file only for ${...} interpolation and does not auto-inject it
# into containers; the environment entry above is what the process sees.
# Without both, the page is read-only and only shows effective values.
# Each save keeps a rotating .env.bak next to this file.
# SETTINGS_ENV_FILE=

# ─── Legacy / removed keys (do NOT add back) ────────────────────────────────
# EDGE_AUTH_HTPASSWD: removed from docker-compose.yml; nginx no longer uses
#   edge basic-auth (app login enforces auth). Delete any stale value.
# GRAFANA_ADMIN_USER: unused; compose sets only GF_SECURITY_ADMIN_PASSWORD.
# UNIFIED_INTERNAL_API_SECRET / MM_CONTROLLER_INTERNAL_SECRET: stale leftovers
#   in .env.enc, unreferenced by code and compose; INTERNAL_API_SECRET is the
#   live secret.

# ─── CI / act (local workflow testing) ───────────────────────────────────────
# These are only read by act (.github/act/run.sh). Never used by docker-compose.

# Required for all jobs — submodule checkout and bisq-bump gh api calls.
GH_PAT=your_github_pat_here

# Required for build-report job (gh api to post workflow summary). Leave empty to skip.
GITHUB_TOKEN=

# Required for pre-deploy / deploy jobs only. Leave empty when only running tests.
VPS_SSH_PRIVATE_KEY=
VPS_SSH_KNOWN_HOSTS=
VPS_SSH_HOST=
VPS_SSH_USER=
VPS_REPO_DIR=
DOTENV_PRIVATE_KEY_ROOT=
DOTENV_PRIVATE_KEY_UNIFIED_API=
DOTENV_PRIVATE_KEY_MONITOR=
DOTENV_PRIVATE_KEY_MM_CONTROLLER=
DOTENV_PRIVATE_KEY_FIAT_CONTROLLER=
TOR_SOCKS_HOST_PORT=''
# Optional remote Bitcoin Core backend (RPC over Tor). Keep the real username
# and password only in .env / .env.enc. LND currently uses Neutrino by default.
LND_BITCOIND_RPCHOST=
LND_BITCOIND_RPCPORT=8332
LND_BITCOIND_RPCUSER=
LND_BITCOIND_RPCPASS=
LND_INIT_FRESH=false
